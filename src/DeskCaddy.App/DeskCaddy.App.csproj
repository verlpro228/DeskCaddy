<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DeskCaddy</RootNamespace>
    <AssemblyName>DeskCaddy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- exe 元数据：右键属性、杀软信誉、安装包卸载列表都会用到 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>DeskCaddy Project</Company>
    <Product>DeskCaddy</Product>
    <Authors>DeskCaddy contributors</Authors>
    <Copyright>© 2026 DeskCaddy contributors. Licensed under GPL-3.0.</Copyright>
    <Description>A macOS-style dock that truly declutters your Windows desktop.</Description>
    <!-- 常驻小工具不需要后台 GC 线程，关掉可省一个线程和一部分提交内存。 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让 GC 主动向系统归还内存，桌面常驻场景下更友好。 -->
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面里用的 Logo（512×512 透明底，由 assets\logo-source.png 缩放生成）。
         用 EmbeddedResource 而非 Resource：资源名是确定的，代码里可直接取流，
         避免 pack URI 解析失败时界面静默空白。 -->
    <EmbeddedResource Include="assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskCaddy.Core\DeskCaddy.Core.csproj" />
  </ItemGroup>

</Project>
