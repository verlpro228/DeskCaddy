<Window x:Class="DeskCaddy.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCaddy Island"
        Width="380"
        Height="54"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 控制按钮：无边框无背景，只在悬停时给一圈浅色底 -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">
        <!-- 与 Dock 同一套毛玻璃配方：截壁纸 + 轻暗色罩 + 白色描边。
             背后没有可用的壁纸时退化成 Dock 的深色底，不会出现实色块。 -->
        <Border x:Name="Pill"
                Width="220"
                CornerRadius="27"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC1A1A20" Offset="0" />
                    <GradientStop Color="#CC0E0E12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Border x:Name="Tint" CornerRadius="26">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1406060A" Offset="0" />
                            <GradientStop Color="#2E06060A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 进度条：铺在胶囊底部，两侧留出圆角余量 -->
                <Rectangle x:Name="ProgressFill"
                           Height="2"
                           Width="0"
                           Fill="#8CFFFFFF"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="20,0,0,4"
                           RadiusX="1"
                           RadiusY="1" />

                <Grid Margin="8,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CoverHost"
                            Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="#26FFFFFF"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CoverGlyph"
                                   Text="&#xE8D6;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="9,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="正在播放"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText"
                                   Text=""
                                   FontSize="10.5"
                                   Foreground="#B3FFFFFF"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="Controls"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="False">
                        <Button x:Name="PreviousButton"
                                Content="&#xE100;"
                                Style="{StaticResource IslandButton}"
                                Click="OnPreviousClick" />
                        <Button x:Name="PlayButton"
                                Content="&#xE768;"
                                Style="{StaticResource IslandButton}"
                                Margin="2,0"
                                Click="OnPlayPauseClick" />
                        <Button x:Name="NextButton"
                                Content="&#xE101;"
                                Style="{StaticResource IslandButton}"
                                Click="OnNextClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
