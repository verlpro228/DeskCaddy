<Window x:Class="DeskCaddy.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCaddy 菜单栏"
        Width="980"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown">

    <Window.Resources>
        <!-- 扁平滑块：白底面板用系统银色滑块很突兀，改成细轨道 + 蓝色圆点 -->
        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="#1A000000"
                                    VerticalAlignment="Center" />

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="#2F6BFF"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#FFFFFF" />
                                                    <Ellipse Stroke="#2F6BFF"
                                                             StrokeThickness="2"
                                                             Margin="2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" Background="#33000000" />
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2F6BFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Foreground" Value="#D9000000" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Nav" CornerRadius="7" Background="Transparent" Padding="10,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#8C000000"
                                           Width="24"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="#0F000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Nav" Property="Background" Value="#17000000" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="#2F6BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#73000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#12000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1F1F23" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="6"
                                Background="#14000000"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#FFFFFF">
        <Grid.Clip>
            <RectangleGeometry x:Name="RootClip" RadiusX="12" RadiusY="12" Rect="0,0,0,0" />
        </Grid.Clip>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#08000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image x:Name="LogoImage"
                               Width="30"
                               Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DeskCaddy"
                                   Foreground="#1F1F23"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="NavHost" Grid.Row="1" Margin="10,4,10,10" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,14,0">
                    <Border Width="330"
                            Height="34"
                            CornerRadius="8"
                            Background="#0F000000"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#1F1F23"
                                     CaretBrush="#1F1F23"
                                     FontSize="12.5"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSearchChanged" />
                            <TextBlock x:Name="SearchHint"
                                       Text="查找设置"
                                       Foreground="#73000000"
                                       FontSize="12.5"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource IconButton}"
                            Width="38"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="✕"
                            FontSize="12"
                            Click="OnCloseClick" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="24,0,20,20"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border BorderBrush="#14000000"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False" />
    </Grid>
</Window>
