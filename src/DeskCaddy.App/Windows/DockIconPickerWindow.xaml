<Window x:Class="DeskCaddy.Windows.DockIconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 Dock 图标"
        Width="420"
        Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="12"
            Background="#FFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,12,0" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="添加 Dock 图标"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#1F1F23"
                           VerticalAlignment="Center" />

                <Button Content="✕"
                        Width="32"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#73000000"
                        Cursor="Hand"
                        Click="OnCloseClick" />
            </Grid>

            <Border Grid.Row="1"
                    Height="34"
                    Margin="20,0,20,12"
                    CornerRadius="8"
                    Background="#0F000000">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="12.5"
                             Foreground="#1F1F23"
                             CaretBrush="#1F1F23"
                             TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchHint"
                               Text="搜索应用"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#73000000"
                               FontSize="12.5"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="12,0,12,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ListHost" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
