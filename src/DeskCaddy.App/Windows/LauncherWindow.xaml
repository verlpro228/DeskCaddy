<Window x:Class="DeskCaddy.Windows.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCaddy 菜单栏"
        Width="880"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnPanelDragOver"
        DragLeave="OnPanelDragLeave"
        Drop="OnPanelDrop">

    <Window.Resources>
        <!-- 细滚动条：面板是深色毛玻璃，系统默认那条亮灰滚动条太突兀 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3"
                                                        Background="#4DFFFFFF"
                                                        Margin="2,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" />
        </Grid.RenderTransform>
        <Grid.Clip>
            <RectangleGeometry x:Name="RootClip" RadiusX="26" RadiusY="26" Rect="0,0,0,0" />
        </Grid.Clip>

        <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False" />
        <Rectangle Fill="#4D000000" IsHitTestVisible="False" />
        <Rectangle Stroke="#33FFFFFF" StrokeThickness="1" RadiusX="26" RadiusY="26" Margin="0.5" IsHitTestVisible="False" />

        <Grid Margin="28,18,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="36"
                    Margin="2,0,2,14"
                    CornerRadius="10"
                    Background="#33FFFFFF">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             CaretBrush="White"
                             FontSize="13"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="OnSearchChanged"
                             KeyDown="OnSearchKeyDown" />
                    <TextBlock x:Name="SearchHint"
                               Text="搜索应用…"
                               Foreground="#80FFFFFF"
                               FontSize="13"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}"
                                        Width="{Binding CellWidth}"
                                        Height="{Binding CellHeight}"
                                        Margin="1"
                                        Tag="{Binding}"
                                        Click="OnItemClick"
                                        MouseDoubleClick="OnTileDoubleClick"
                                        PreviewMouseLeftButtonDown="OnTileMouseDown"
                                        PreviewMouseMove="OnTileMouseMove"
                                        MouseRightButtonUp="OnTileRightClick"
                                        ToolTip="{Binding Name}">
                                    <Grid>
                                        <!-- 双击模式下的选中反馈：只画图标外圈描边，不填充、不盖住图标 -->
                                        <Border CornerRadius="12"
                                                BorderBrush="#8CFFFFFF"
                                                BorderThickness="1.5"
                                                Width="{Binding RingWidth}"
                                                Height="{Binding RingWidth}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,3,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel>
                                            <Image Source="{Binding Icon}"
                                                   Width="{Binding IconSize}"
                                                   Height="{Binding IconSize}"
                                                   Margin="0,10,0,8"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F2FFFFFF"
                                                       FontSize="11.5"
                                                       MaxWidth="{Binding LabelWidth}"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="没有匹配的应用"
                           Foreground="#99FFFFFF"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <!-- 拖拽时的浮动图标：跟随光标，让位效果更直观 -->
                <Canvas x:Name="DragGhostHost"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Image x:Name="DragGhost"
                           Width="44"
                           Height="44"
                           Opacity="0.85"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Canvas>
            </Grid>
        </Grid>
    </Grid>

</Window>
