<Window x:Class="DeskCaddy.Windows.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:DeskCaddy.Rendering"
        Title="DeskCaddy"
        Width="360"
        Height="65"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <Grid>
        <rendering:DockStripView x:Name="Strip" />

        <!-- 拖拽时的浮动图标：跟随光标，与菜单栏一致 -->
        <Canvas x:Name="DragGhostHost"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Image x:Name="DragGhost"
                   Width="40"
                   Height="40"
                   Opacity="0.85"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Canvas>
    </Grid>

</Window>
